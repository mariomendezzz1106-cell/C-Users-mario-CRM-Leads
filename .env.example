# Copia este fichero como .env y rellena los valores. .env NUNCA se sube a Git.

# Conexión a PostgreSQL (en Render se rellena sola desde la base de datos)
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASEÑA@127.0.0.1:5432/crm

# Clave para firmar las sesiones: 64 caracteres aleatorios.
# Genérala en PowerShell con:  -join ((1..64) | % { '{0:x}' -f (Get-Random -Max 16) })
SECRET_KEY=

# true en producción (cookies solo por HTTPS). En local, false.
PRODUCCION=false

# Registro público de empresas (true/false)
ALLOW_SIGNUP=true

# Clave de la API de Claude para el panel de IA (opcional; sin ella la IA queda desactivada)
ANTHROPIC_API_KEY=
MODELO_IA=claude-opus-5-5
LIMITE_IA_DIARIO=60
